# Copy to android/keystore.properties and fill in. That file is gitignored and
# must never be committed — it holds the passwords to your signing key.
#
# Generate the key once, and keep both it and these passwords safe. Google Play
# ties your listing to this key: lose it and the app can never be updated under
# the same listing again. Back it up somewhere that is not only this laptop.
#
#   keytool -genkey -v -keystore aconsu-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias aconsu
#
# storeFile is relative to the android/ directory, or an absolute path. Keeping
# the .jks outside the repository entirely is the safer habit.

storeFile=../aconsu-release.jks
storePassword=CHANGE_ME
keyAlias=aconsu
keyPassword=CHANGE_ME
