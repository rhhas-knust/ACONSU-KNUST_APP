PORT=3000
NODE_ENV=development

# Session security
SESSION_SECRET=change_this_to_a_long_random_string

# Admin login — change these before you deploy anywhere
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# MongoDB Atlas connection string — see README section "MongoDB Atlas setup"
# Looks like: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/aconsu?retryWrites=true&w=majority
MONGODB_URI=
