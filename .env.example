# Copy this file to .env and fill in real values. .env is gitignored; THIS
# file is committed and public, so never put a real secret in it.
PORT=7000
NODE_ENV=development

# Session security — any long random string, unique per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server refuses to start unless this is set.
SESSION_SECRET=

# Admin login. In production the server refuses to start unless ADMIN_PASSWORD
# is set, because the built-in fallback would otherwise let anyone sign in as
# the national administrator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Leadership portals (Coordinator, Finance, Shepherding, Publicity, Executive)
# sign in with accounts created under "Leadership Accounts". Nothing to
# configure here for those.
#
# The pair below is the original shepherding-only login and still works, so
# whoever uses it today keeps access until their proper account is created.
# Leave it blank once every leader has an account of their own.
SHEPHERD_USERNAME=
SHEPHERD_PASSWORD=

# SMS (mNotify) — used by the Publicity portal to text members.
# Get an API key at https://mnotify.com and register your sender ID (max 11
# characters, e.g. ACONSU). Leave blank to disable SMS: publicity can still
# compose and schedule messages, and every send is logged, but nothing is
# actually delivered until these are set.
MNOTIFY_API_KEY=
SMS_SENDER_ID=ACONSU

# MongoDB Atlas connection string — see README section "MongoDB Atlas setup".
# Also where sessions are stored, so signing in survives a restart or deploy.
# Looks like: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/aconsu?retryWrites=true&w=majority
MONGODB_URI=

# Push notifications — see README section "Push notifications setup".
# Generate with: npx web-push generate-vapid-keys
# The public key is safe to expose; the private key is not.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: a mailto: or an https:// address (a plain
# email address also works). No domain of our own is needed. Left blank, the
# MAIL_FROM address or the app's own https address is used.
VAPID_SUBJECT=mailto:admin@aconsu.org

# Email sending — used for member password reset links, and for notifying the
# admin by email whenever someone submits a join request, prayer request,
# testimony, or contact message. Works with any standard SMTP provider — Gmail
# (with an App Password), SendGrid, Mailgun, Zoho, etc. Leave blank to disable
# emails entirely; the app still works fine without this, these features just
# won't send real emails until it's configured.
#
# Admin notification emails also require a "Contact Email" to be set under
# Site Settings in the admin dashboard — that's where they'll be sent to.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ACONSU <noreply@aconsu.org>

# ---------------------------------------------------------------------------
# The app's address, and what waits for a domain.
# docs/when-you-have-a-domain.md says what to set, in order, the day there is
# one. /api/health lists which of these are on and which are still waiting.
# ---------------------------------------------------------------------------

# The address people use, e.g. https://app.example.org: "https://", the name,
# no path and no "/" at the end. Links in emails, the sitemap and robots.txt
# use it. Blank: links use the host's own address (Render sets
# RENDER_EXTERNAL_URL itself) and there is no sitemap. In production with
# neither, password reset emails are not sent rather than built from whatever
# address the request claimed.
PUBLIC_BASE_URL=

# Leave blank. Sign-in cookies then belong to exactly the app's address. Only
# for sharing sign-in across several names, e.g. COOKIE_DOMAIN=example.org.
COOKIE_DOMAIN=

# The Android app's Digital Asset Links, as the one-line JSON the Play Console
# gives you (App integrity, App signing). Served at
# /.well-known/assetlinks.json; blank, that address answers 404.
ANDROID_ASSET_LINKS=

# The public website's address(es), comma-separated, allowed to send the
# alumni form to the app. Blank: https://rhhas-knust.github.io
SITE_ORIGINS=
